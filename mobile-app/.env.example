# For Android emulators, use http://10.0.2.2:5000/api and http://10.0.2.2:5000.
# For physical phones, use the computer's LAN address; for deployed builds use the Render URLs.
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Add these after creating/linking the app with Expo EAS.
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
