{
  "expo": {
    "name": "FieldFix",
    "slug": "fieldfix-mobile-app",
    "entryPoint": "./index.js",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.fieldfix.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fieldfix.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FieldFix to use your location for booking and technician tracking."
        }
      ]
    ]
  }
}
