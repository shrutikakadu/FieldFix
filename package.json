{
  "name": "fieldfix-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "FieldFix - End-to-end Field Service Management System",
  "workspaces": [
    "backend",
    "admin-dashboard",
    "mobile-app"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:backend\" \"npm run start:web\"",
    "start:backend": "npm --prefix backend run dev",
    "start:web": "npm --prefix admin-dashboard run dev",
    "start:admin": "npm --prefix admin-dashboard run dev",
    "start:mobile": "npm --prefix mobile-app run start",
    "start:mobile:web": "npm --prefix mobile-app run web",
    "build:backend": "npm --prefix backend run build",
    "build:admin": "npm --prefix admin-dashboard run build",
    "build:web": "npm --prefix admin-dashboard run build"
  },
  "keywords": [
    "field-service",
    "react-native",
    "react",
    "nodejs",
    "express",
    "socket.io",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
